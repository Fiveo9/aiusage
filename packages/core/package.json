{
  "name": "@aiusage/core",
  "version": "1.5.28",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./exchange-rate": {
      "types": "./dist/exchange-rate.d.ts",
      "import": "./dist/exchange-rate.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/recycle-output.cjs packages/core/dist && tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
